<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:GeoServerDesktop.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="GeoServerDesktop.App.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header -->
        <Border Grid.Row="0" Background="#F5F5F5" Padding="10" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="{Binding L.DashboardTitle}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button Content="{Binding L.Refresh}"
                        Command="{Binding RefreshCommand}"
                        IsEnabled="{Binding IsConnected}"
                        ToolTip.Tip="{Binding L.DashboardRefreshToolTip}"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" Padding="20">
            <StackPanel Spacing="15" MaxWidth="900">
                <!-- Welcome Message (disconnected only) -->
                <TextBlock Text="{Binding L.DashboardWelcomeMessage}"
                           FontSize="14"
                           TextWrapping="Wrap"
                           Foreground="#666666"
                           IsVisible="{Binding !IsConnected}"/>

                <!-- Overview Cards -->
                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="15">
                    <!-- Connection Status -->
                    <Border Grid.Column="0" Background="#F5F5F5" Padding="15" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding L.DashboardConnectionStatus}" FontWeight="Bold" FontSize="13" Foreground="#555555"/>
                            <TextBlock Text="{Binding L.DashboardConnected}"
                                       FontSize="20" FontWeight="Bold" Foreground="#4CAF50"
                                       IsVisible="{Binding IsConnected}"/>
                            <TextBlock Text="{Binding L.DashboardNotConnected}"
                                       FontSize="20" Foreground="#999999"
                                       IsVisible="{Binding !IsConnected}"/>
                            <TextBlock Text="{Binding ServerUrl}" FontSize="11" Foreground="#666666" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- GeoServer Version -->
                    <Border Grid.Column="1" Background="#F5F5F5" Padding="15" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding L.DashboardGeoServerVersion}" FontWeight="Bold" FontSize="13" Foreground="#555555"/>
                            <TextBlock Text="{Binding GeoServerVersion}" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <!-- Workspaces Count -->
                    <Border Grid.Column="2" Background="#F5F5F5" Padding="15" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding L.DashboardWorkspaces}" FontWeight="Bold" FontSize="13" Foreground="#555555"/>
                            <TextBlock Text="{Binding WorkspaceCountText}" FontSize="28" FontWeight="Bold" Foreground="#2C5F8D"/>
                        </StackPanel>
                    </Border>

                    <!-- Layers Count -->
                    <Border Grid.Column="3" Background="#F5F5F5" Padding="15" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding L.DashboardLayers}" FontWeight="Bold" FontSize="13" Foreground="#555555"/>
                            <TextBlock Text="{Binding LayerCountText}" FontSize="28" FontWeight="Bold" Foreground="#2C5F8D"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Loading Indicator -->
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#F5F5F5" Padding="10" BorderBrush="#CCCCCC" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
