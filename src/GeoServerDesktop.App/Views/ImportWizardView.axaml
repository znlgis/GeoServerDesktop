<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:GeoServerDesktop.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="GeoServerDesktop.App.Views.ImportWizardView"
             x:DataType="vm:ImportWizardViewModel">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header -->
        <Border Grid.Row="0" Background="#F5F5F5" Padding="15" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="{Binding L.WizardTitle}"
                           FontSize="24"
                           FontWeight="Bold"/>
                <TextBlock Text="{Binding StepIndicator}"
                           FontSize="13"
                           Foreground="#666666"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="15" Spacing="12">
                <TextBlock Text="{Binding StepTitle}"
                           FontSize="18"
                           FontWeight="Bold"/>

                <!-- 第 1 步：选择数据源 -->
                <StackPanel Spacing="10" IsVisible="{Binding IsStep1}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding L.WizardSourceKindLabel}" FontWeight="Bold"/>
                        <ComboBox ItemsSource="{Binding SourceKinds}"
                                  SelectedIndex="{Binding SourceKindIndex}"
                                  HorizontalAlignment="Left"
                                  MinWidth="260"/>
                    </StackPanel>

                    <!-- 文件引用（Shapefile / GeoTIFF） -->
                    <StackPanel Spacing="10" IsVisible="{Binding IsFileSource}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding L.WizardFileRefLabel}" FontWeight="Bold"/>
                            <TextBox Text="{Binding FileRef}"
                                     Watermark="{Binding L.WizardFileRefWatermark}"/>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding L.WizardNativeNameLabel}" FontWeight="Bold"/>
                            <TextBox Text="{Binding NativeName}" MaxWidth="360" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- PostGIS 连接参数 -->
                    <StackPanel Spacing="10" IsVisible="{Binding IsPostgisSource}">
                        <Grid ColumnDefinitions="160,220" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding L.WizardPgHostLabel}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding PgHost}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding L.WizardPgPortLabel}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PgPort}" MaxWidth="120" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding L.WizardPgDatabaseLabel}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding PgDatabase}"/>
                        </Grid>
                        <Grid ColumnDefinitions="160,220" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding L.WizardPgUserLabel}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding PgUser}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding L.WizardPgPasswordLabel}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PgPassword}" PasswordChar="*"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <!-- 第 2 步：目标与参数 -->
                <StackPanel Spacing="10" IsVisible="{Binding IsStep2}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding L.WizardWorkspaceLabel}" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox ItemsSource="{Binding Workspaces}"
                                      SelectedItem="{Binding SelectedWorkspace}"
                                      MinWidth="260"/>
                            <Button Content="{Binding L.WizardRefreshButton}"
                                    Command="{Binding LoadWorkspacesCommand}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding L.WizardPublishNameLabel}" FontWeight="Bold"/>
                        <TextBox Text="{Binding PublishName}" MaxWidth="360" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding L.WizardStoreNameLabel}" FontWeight="Bold"/>
                        <TextBox Text="{Binding StoreName}" MaxWidth="360" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding L.WizardSrsLabel}" FontWeight="Bold"/>
                        <TextBox Text="{Binding Srs}" MaxWidth="360" HorizontalAlignment="Left"/>
                    </StackPanel>

                    <!-- PostGIS 连接探测 -->
                    <StackPanel Spacing="6" IsVisible="{Binding IsPostgisSource}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{Binding L.WizardProbeButton}"
                                    Command="{Binding ProbePostgisCommand}"/>
                            <TextBlock Text="{Binding ProbeMessage}"
                                       VerticalAlignment="Center"
                                       Foreground="#666666"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 本地预检（可选） -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding L.WizardLocalPreviewLabel}" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox Text="{Binding LocalPreviewPath}" MinWidth="360"/>
                            <Button Content="{Binding L.WizardInspectButton}"
                                    Command="{Binding InspectLocalPathCommand}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding PreviewText}"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   Foreground="#444444"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>

                <!-- 第 3 步：发布 -->
                <StackPanel Spacing="10" IsVisible="{Binding IsStep3}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding L.WizardResultLabel}" FontWeight="Bold"/>
                        <TextBlock Text="{Binding ResultMessage}" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#F5F5F5" Padding="15" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Width="200" HorizontalAlignment="Left"/>
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="#666666"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="{Binding L.WizardBackButton}"
                            Command="{Binding BackStepCommand}"
                            IsVisible="{Binding !IsStep1}"/>
                    <Button Content="{Binding L.WizardNextButton}"
                            Command="{Binding NextStepCommand}"
                            IsVisible="{Binding !IsStep3}"/>
                    <Button Content="{Binding L.WizardPublishButton}"
                            Command="{Binding PublishCommand}"
                            IsVisible="{Binding IsStep3}"
                            Background="#2196F3"
                            Foreground="White"/>
                    <Button Content="{Binding L.WizardRestartButton}"
                            Command="{Binding RestartCommand}"
                            IsVisible="{Binding IsStep3}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
